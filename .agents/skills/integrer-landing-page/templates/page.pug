extends fragments/base

block variables
  - var titrePage = "{{Titre}}"
  - var descriptionPage = "{{description}}"
  - var classePage = "page-{{route}}"
  - var ariane = []
  - ariane[0] = { id: 'accueil', label: 'Accueil', href: '/' }
  - ariane[1] = { id: '{{route}}', label: "{{Titre}}", href: '#' }

block heros
    dsc-heros(
        variant= "clair"
        ariane= ariane
    )
        h1.titre-alternatif-xs(slot="titre") #{titrePage}
        p.fr-text--lead(slot="description") #{descriptionPage}
        .actions
            dsfr-button(
                label="{{libellé CTA}}"
                kind="primary"
                markup="a"
                href="#{{ancre}}"
            )

block contenu
    dsc-{{route}}

    block apres-contenu
