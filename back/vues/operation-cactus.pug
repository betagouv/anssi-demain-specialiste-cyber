extends fragments/base

block variables
  - var titrePage = "Opération Cactus"
  - var classePage = "page-operation-cactus"
  - var ariane = []
  - ariane[0] = { id: 'accueil', label: 'Accueil', href: '/' }
  - ariane[1] = { id: 'operation-cactus', label: 'Opération Cactus', href: '#' }

block heros
    dsc-heros(
        variant= "clair"
        ariane= ariane
    )
        h1.titre-alternatif-xs(slot="titre") #{titrePage}
        p.fr-text--lead(slot="description") L’opération nationale de sensibilisation au risque d’hameçonnage (<em>phishing</em>).
        .actions
            dsfr-button(
                label="Découvrez les ressources pour sensibiliser"
                kind="primary"
                markup="a"
                href="/selection-enseignants#sensibiliser"
                target="_blank"
            )
        img(slot="illustration" src="/assets/images/operation-cactus/hero.jpg" alt="")

block contenu
    dsc-operation-cactus

    block apres-contenu
