extends fragments/base

block variables
  - var titrePage = "Passe Ton Hack d’Abord"
  - var descriptionPage = "Le premier challenge de cybersécurité en lycée organisé par le COMCYBER et le Ministère de l’Éducation."
  - var classePage = "page-passe-ton-hack-d-abord"
  - var ariane = []
  - ariane[0] = { id: 'accueil', label: 'Accueil', href: '/' }
  - ariane[1] = { id: 'passe-ton-hack-d-abord', label: "Passe Ton Hack d’Abord", href: '#' }

block heros
    dsc-heros(
        variant= "clair"
        ariane= ariane
    )
        h1.titre-alternatif-xs(slot="titre") #{titrePage}
        p.fr-text--lead(slot="description") #{descriptionPage}
        .actions
            dsfr-button(
                label="Inscrire mes élèves"
                kind="primary"
                markup="a"
                href="https://fcsc.fr/fr/"
                blank
            )
        img.illustration(slot="illustration" src="/assets/images/passe-ton-hack-d-abord/hero.png" alt="")

block contenu
    dsc-passe-ton-hack-d-abord

    block apres-contenu
