{
  "name": "anssi-demain-specialiste-cyber",
  "version": "2.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/betagouv/anssi-demain-specialiste-cyber.git"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --reporter=append-only -r dev",
    "dev:front": "pnpm --filter anssi-demain-specialiste-cyber-front dev",
    "dev:back": "pnpm --filter anssi-demain-specialiste-cyber-back dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "migre-bdd": "pnpm --filter anssi-demain-specialiste-cyber-back migre-bdd",
    "start": "pnpm --filter anssi-demain-specialiste-cyber-back start ",
    "test": "pnpm --reporter=append-only -r test",
    "test:ci": "pnpm -r test:ci",
    "typecheck": "pnpm -r typecheck",
    "admin": "node -e \"const admin = new (require('./back/dist/src/admin/consoleAdministration.js').ConsoleAdministration)()\" -i",
    "admin:dev": "pnpm --filter anssi-demain-specialiste-cyber-back build && node --env-file back/.env -e \"const admin = new (require('./back/dist/src/admin/consoleAdministration.js').ConsoleAdministration)()\" -i"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "zod": "^4.3.6"
  },
  "private": true
}
